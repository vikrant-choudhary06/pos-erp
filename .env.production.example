# Copy to .env.production and fill in. Used by docker-compose.prod.yml.

# The domain pointing at this server, without https://
DOMAIN=pos.example.com

# Bundled Postgres. Pick a long random password.
POSTGRES_USER=pos
POSTGRES_PASSWORD=
POSTGRES_DB=pos

# Or use a hosted database (Supabase, Neon) and remove the postgres service:
# DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require

# 32+ random characters, e.g. `openssl rand -hex 32`
OTP_SECRET=

# Resend API key and a sender on a domain verified in Resend
RESEND_API_KEY=
MAIL_FROM="Rizzoto <login@example.com>"
